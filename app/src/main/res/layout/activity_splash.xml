<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#2E7D32">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:gravity="center"

        android:orientation="vertical"

        android:padding="30dp">


        <androidx.cardview.widget.CardView

            android:layout_width="140dp"
            android:layout_height="140dp"

            app:cardCornerRadius="70dp"

            app:cardElevation="12dp"

            app:cardBackgroundColor="#FFFFFF">


            <TextView

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:text="♻"

                android:textSize="80sp"

                android:textColor="#2E7D32"

                android:gravity="center"/>


        </androidx.cardview.widget.CardView>


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="35dp"

            android:text="MANAJEMEN"

            android:textColor="#FFFFFF"

            android:textSize="32sp"

            android:textStyle="bold"/>




        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="SAMPAH"

            android:textColor="#FFFFFF"

            android:textSize="32sp"

            android:textStyle="bold"/>


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="15dp"

            android:text="Kelola sampah lebih mudah"

            android:textColor="#E8F5E9"

            android:textSize="17sp"/>



        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Monitoring lingkungan secara digital"

            android:textColor="#C8E6C9"

            android:textSize="13sp"/>


        <ProgressBar

            android:layout_width="50dp"

            android:layout_height="50dp"

            android:layout_marginTop="45dp"

            android:indeterminateTint="#FFFFFF"/>





        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="Menyiapkan aplikasi..."

            android:textColor="#FFFFFF"

            android:textSize="14sp"/>


        <LinearLayout

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="55dp"

            android:gravity="center"

            android:orientation="vertical">


            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="♻ Manajemen Sampah Digital"

                android:textColor="#FFFFFF"

                android:textSize="16sp"

                android:textStyle="bold" />




            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="Version 1.0"

                android:textColor="#C8E6C9"

                android:textSize="12sp"/>


        </LinearLayout>



    </LinearLayout>


</RelativeLayout>