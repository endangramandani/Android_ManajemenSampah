<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FBF4"
    android:fillViewport="true">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:gravity="center_horizontal"

        android:padding="24dp">

        <androidx.cardview.widget.CardView

            android:layout_width="110dp"
            android:layout_height="110dp"

            android:layout_marginTop="40dp"

            app:cardCornerRadius="55dp"

            app:cardElevation="4dp"

            app:cardBackgroundColor="#E8F5E9">


            <TextView

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:text="♻"

                android:textSize="65sp"

                android:textColor="#2E7D32"

                android:gravity="center"/>


        </androidx.cardview.widget.CardView>


        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="MANAJEMEN SAMPAH"

            android:textColor="#1B5E20"

            android:textSize="26sp"

            android:textStyle="bold"/>



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Kelola sampah lebih mudah dan terorganisir"

            android:textColor="#777777"

            android:textSize="14sp"/>


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="35dp"

            app:cardCornerRadius="25dp"

            app:cardElevation="8dp"

            app:cardBackgroundColor="#FFFFFF">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="25dp">



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Login"

                    android:textColor="#1B5E20"

                    android:textSize="22sp"

                    android:textStyle="bold"/>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Silakan masuk untuk mengakses aplikasi"

                    android:textColor="#888888"

                    android:textSize="13sp"/>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="25dp"

                    android:text="Username"

                    android:textColor="#1B5E20"

                    android:textSize="15sp"

                    android:textStyle="bold"/>




                <EditText

                    android:id="@+id/etUsername"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="8dp"

                    android:padding="15dp"

                    android:background="#F8FFF8"

                    android:hint="Masukkan username"

                    android:textColor="#333333"

                    android:textColorHint="#999999"

                    android:textSize="15sp"/>


                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="Password"

                    android:textColor="#1B5E20"

                    android:textSize="15sp"

                    android:textStyle="bold"/>




                <EditText

                    android:id="@+id/etPassword"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="8dp"

                    android:padding="15dp"

                    android:background="#F8FFF8"

                    android:hint="Masukkan password"

                    android:textColor="#333333"

                    android:textColorHint="#999999"

                    android:textSize="15sp"

                    android:inputType="textPassword"/>


                <Button

                    android:id="@+id/btnLogin"

                    android:layout_width="match_parent"

                    android:layout_height="58dp"

                    android:layout_marginTop="30dp"

                    android:backgroundTint="#2E7D32"

                    android:text="LOGIN"

                    android:textAllCaps="false"

                    android:textColor="#FFFFFF"

                    android:textSize="17sp"

                    android:textStyle="bold"/>



            </LinearLayout>


        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardCornerRadius="18dp"

            app:cardElevation="2dp"

            app:cardBackgroundColor="#E8F5E9">



            <TextView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:padding="18dp"

                android:text="Aplikasi ini membantu pencatatan dan monitoring data sampah secara digital."

                android:textColor="#2E7D32"

                android:textSize="13sp"/>


        </androidx.cardview.widget.CardView>

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="35dp"

            android:text="♻ Manajemen Sampah Digital"

            android:textColor="#2E7D32"

            android:textSize="15sp"

            android:textStyle="bold"/>

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="© 2026 All Rights Reserved"

            android:textColor="#888888"

            android:textSize="12sp"/>



    </LinearLayout>


</ScrollView>